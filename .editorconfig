# Tıp Eğitimi Platformu — kodlama standardı ayarları
# Kaynak: C# Kodlama Standardı belgesi. Değişiklik yalnızca ADR ile.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.cs]
# Biçim
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0005.severity = error   # kullanılmayan using
dotnet_diagnostic.IDE0161.severity = error   # dosya kapsamlı namespace
dotnet_diagnostic.IDE0011.severity = error   # süslü parantez

# Adlandırma: arayüzler I ile başlar
dotnet_naming_rule.interfaces_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_i.style = i_prefix
dotnet_naming_rule.interfaces_i.severity = error
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

# Adlandırma: özel alanlar _camelCase
dotnet_naming_rule.private_fields.symbols = private_field_symbols
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = error
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Adlandırma: async metotlar Async ile biter
dotnet_naming_rule.async_methods.symbols = async_method_symbols
dotnet_naming_rule.async_methods.style = async_suffix
dotnet_naming_rule.async_methods.severity = error
dotnet_naming_symbols.async_method_symbols.applicable_kinds = method
dotnet_naming_symbols.async_method_symbols.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case

# Türkçe karakter ve kültür tuzakları (zorunlu)
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error

# Günlük: mesaj şablonu zorunlu
dotnet_diagnostic.CA2254.severity = error

# Karmaşıklık ve bağlaşıklık (eşikler CodeMetricsConfig.txt içinde)
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1506.severity = error

# Gerekçesiz bastırma yasak
dotnet_diagnostic.IDE0076.severity = error
dotnet_diagnostic.IDE0077.severity = error

[**/Migrations/*.cs]
# Üretilmiş geçiş dosyaları boyut kurallarından muaf
generated_code = true
