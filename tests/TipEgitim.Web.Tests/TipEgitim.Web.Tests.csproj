  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TipEgitim.Web\TipEgitim.Web.csproj" />
  </ItemGroup>
</Project>
